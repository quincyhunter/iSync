{
  "name": "isync-backend",
  "version": "1.0.0",
  "description": "iSync Music Manager - Lambda Functions Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "dev:watch": "tsx --watch src/functions/*/index.ts",
    "deploy:all": "npm run build && tsx scripts/deploy.ts",
    "deploy:function": "tsx scripts/deploy.ts",
    "generate:event": "tsx scripts/generate-event.ts",
    "test:local": "tsx scripts/test-local.ts"
  },
  "keywords": [
    "aws",
    "lambda",
    "music",
    "serverless",
    "typescript"
  ],
  "author": "iSync Music Manager",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-auto-scaling": "^3.478.0",
    "@aws-sdk/client-cloudwatch": "^3.478.0",
    "@aws-sdk/client-dynamodb": "^3.478.0",
    "@aws-sdk/client-ec2": "^3.478.0",
    "@aws-sdk/client-s3": "^3.478.0",
    "@aws-sdk/client-sqs": "^3.478.0",
    "@aws-sdk/lib-dynamodb": "^3.478.0",
    "@aws-sdk/s3-request-presigner": "^3.478.0",
    "date-fns": "^3.0.6",
    "music-metadata": "^8.1.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/aws-lambda": "^8.10.130",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "archiver": "^6.0.1",
    "aws-sdk-client-mock": "^3.0.1",
    "dotenv": "^16.3.1",
    "esbuild": "^0.19.10",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
